# Copy this file to .env and adjust. Docker Compose reads .env automatically.

# Host port for the web UI (the container always listens on 3000).
SERVER_PORT=3900

# Network interface the web UI listens on. The UI has no login, so by default
# it is reachable only from this machine. Set to 0.0.0.0 to open it to other
# devices on your network — only do that on a network you trust.
SERVER_BIND=127.0.0.1

# When scheduled downloads run, in cron format:
#   minute hour day-of-month month day-of-week
# Default: every day at noon (in the TZ below).
CRON_SCHEDULE=0 12 * * *

# Timezone for the schedule, e.g. America/New_York or Europe/London.
TZ=UTC

# Run one download as soon as the downloader container starts: 1=yes, 0=no
RUN_ON_START=1

# Log level for the downloader and web UI: debug | info | warn | error | none
LOG_LEVEL=info

# Image to run. Override to pin a release, e.g. ghcr.io/justinmpowers/patreon-dl-docker:v1.0.0
# IMAGE=ghcr.io/justinmpowers/patreon-dl-docker:latest
